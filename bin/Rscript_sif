#!/bin/bash
set -eo pipefail
umask 077
ROOT="${SCRIPTS_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
export SCRIPTS_DIR="$ROOT"
source "${POE_SITE_FILE:-$ROOT/config/seadragon.sh}"
[[ -f "$POE_R_SIF" && -d "$POE_R_LIBRARY" ]] || {
  printf 'Missing R image or R library; inspect config/seadragon.sh\n' >&2; exit 1;
}
bootstrap="$ROOT/R/library_paths.R"
[[ -r "$bootstrap" ]] || {
  printf 'Missing R library initializer: %s\n' "$bootstrap" >&2; exit 1;
}
# Script entry points source the initializer before reading their YAML.
# Inline expressions have no entry point, so prepend initialization explicitly.
# Stop scanning at the script/--args boundary: a script argument named -e is data.
r_args=("$@")
for ((i=0; i<${#r_args[@]}; i++)); do
  case "${r_args[i]}" in
    -e)
      r_args=("${r_args[@]:0:i}" -e 'source(Sys.getenv("POE_R_BOOTSTRAP"))' "${r_args[@]:i}")
      break ;;
    --args|--file=*|--) break ;;
    --*) ;; # Leading Rscript/R options remain before the initialization expression.
    *) break ;;
  esac
done
# Do not inherit native conda/venv linker or Python settings into R.
stan_env=()
for control in H1_PREP_WORKERS H1_PREP_MEMORY_GB LSB_DJOB_NUMPROC LSB_MAX_NUM_PROCESSORS LSB_JOBID; do
  if [[ -n "${!control:-}" ]]; then
    [[ "${!control}" =~ ^[0-9]+([.][0-9]+)?$ ]] || {
      printf 'Invalid numeric resource control: %s\n' "$control" >&2; exit 1;
    }
    stan_env+=(--env "$control=${!control}")
  fi
done
# One computational thread per preparation process, including native libraries.
if [[ " $* " == *" h1-inputs "* ]]; then
  for control in OMP_NUM_THREADS OPENBLAS_NUM_THREADS MKL_NUM_THREADS VECLIB_MAXIMUM_THREADS NUMEXPR_NUM_THREADS; do
    stan_env+=(--env "$control=1")
  done
fi
if [[ -n "${CMDSTAN:-}" ]]; then
  [[ "$CMDSTAN" == /* && "$CMDSTAN" != *","* && "$CMDSTAN" != *$'\n'* ]] || {
    printf 'CMDSTAN must be an absolute path without commas or newlines\n' >&2; exit 1;
  }
  stan_env+=(--env "CMDSTAN=$CMDSTAN")
fi
if [[ -n "${POE_CMDSTAN_ENV:-}" ]]; then
  [[ "$POE_CMDSTAN_ENV" =~ ^/[A-Za-z0-9_./+-]+$ ]] || {
    printf 'POE_CMDSTAN_ENV must be an absolute tool prefix without whitespace or metacharacters\n' >&2; exit 1;
  }
  stan_env+=(--env "POE_CMDSTAN_ENV=$POE_CMDSTAN_ENV")
fi
exec env -u LD_LIBRARY_PATH -u PYTHONPATH -u PYTHONHOME \
  "$POE_SINGULARITY" exec --cleanenv --bind /rsrch5 --bind /rsrch9 --bind /tmp \
  --env "R_LIBS_USER=$POE_R_LIBRARY" \
  --env "POE_R_LIBRARY=$POE_R_LIBRARY" --env "POE_R_BOOTSTRAP=$bootstrap" \
  "${stan_env[@]}" \
  "$POE_R_SIF" Rscript "${r_args[@]}"
